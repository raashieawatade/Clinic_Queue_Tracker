PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/clinic-queue

# Receptionist login (choose your own values; never commit the real .env)
RECEPTIONIST_USERNAME=reception
RECEPTIONIST_PASSWORD=change_this_password

# Long random string used to sign receptionist sessions
AUTH_SECRET=replace_with_a_long_random_string

# Optional: deployed frontend URL(s), comma-separated, to restrict CORS
# CLIENT_URL=https://your-frontend.vercel.app
